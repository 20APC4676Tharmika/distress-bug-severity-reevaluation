<mxfile host="app.diagrams.net"><diagram name="Methodology" id="m1"><mxGraphModel dx="1100" dy="950" grid="1" gridSize="10" guides="1" page="1" pageWidth="900" pageHeight="1042" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bz" value="&lt;b&gt;Bugzilla&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;32,428 bug reports: the description and the severity set in the tracker&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="300" height="84" as="geometry"/></mxCell><mxCell id="gh" value="&lt;b&gt;GitHub Issues&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;32,829 issues: title, body, and the dates each was opened and closed&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="340" y="20" width="300" height="84" as="geometry"/></mxCell><mxCell id="so" value="&lt;b&gt;Stack Overflow&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;13,927 questions from 8 API tags; no label&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="680" y="20" width="200" height="84" as="geometry"/></mxCell><mxCell id="cl" value="&lt;b&gt;Cleaning&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Text lower-cased; links, HTML and symbols removed; exact duplicates dropped before any split. This left 32,415 Bugzilla reports and 29,384 completed GitHub issues.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="144" width="620" height="80" as="geometry"/></mxCell><mxCell id="socl" value="&lt;b&gt;Cleaning&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Same steps; no duplicates found&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="680" y="144" width="200" height="80" as="geometry"/></mxCell><mxCell id="bzl" value="&lt;b&gt;Bugzilla labels and split&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Blocker and critical became Critical, major became High, and normal, minor and trivial became Low. Stratified 70/15/15 split (seed 42). No report is shared between splits.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="264" width="300" height="126" as="geometry"/></mxCell><mxCell id="ghl" value="&lt;b&gt;GitHub labels and split&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Random 70/15/15 split (seed 42). Resolution time cut into Fast, Medium and Slow at tertiles taken from the training set only. No issue is shared between splits.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="340" y="264" width="300" height="126" as="geometry"/></mxCell><mxCell id="sol" value="&lt;b&gt;No label&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Used only to compare emotions across the three platforms&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="680" y="264" width="200" height="126" as="geometry"/></mxCell><mxCell id="mk" value="&lt;b&gt;Severity-word masking&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Words such as blocker, critical and major are removed from the text&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="430" width="300" height="80" as="geometry"/></mxCell><mxCell id="note2" value="GitHub: nothing to mask, since the label never appears in the text" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontStyle=2;fontSize=11;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="490" y="430" width="150" height="80" as="geometry"/></mxCell><mxCell id="fc" value="&lt;b&gt;Features (learned from the training set only)&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6C8EBF;dashed=1;verticalAlign=top;fontFamily=Helvetica;fontSize=12;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="550" width="620" height="168" as="geometry"/></mxCell><mxCell id="f1" value="&lt;b&gt;TF-IDF&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Single words and two-word phrases, 20,000 features&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="34" y="584" width="188" height="100" as="geometry"/></mxCell><mxCell id="f2" value="&lt;b&gt;Emotion scores&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Seven emotion probabilities from a pretrained classifier&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="236" y="584" width="188" height="100" as="geometry"/></mxCell><mxCell id="f3" value="&lt;b&gt;Keyword counts&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Counts for six distress categories, plus their total&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="438" y="584" width="188" height="100" as="geometry"/></mxCell><mxCell id="note3" value="A1 text only · A2 + emotions · A3 + keywords · A4 + both · A5 emotions and keywords only" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontStyle=2;fontSize=11;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="688" width="620" height="24" as="geometry"/></mxCell><mxCell id="m1" value="&lt;b&gt;Classical models&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Logistic regression, SVM, random forest, naive Bayes, XGBoost&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="758" width="193" height="96" as="geometry"/></mxCell><mxCell id="m2" value="&lt;b&gt;Sequence models&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;LSTM, BiLSTM and CNN+BiLSTM&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="233" y="758" width="193" height="96" as="geometry"/></mxCell><mxCell id="m3" value="&lt;b&gt;Transformers&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;BERT, RoBERTa and CodeBERT, fine-tuned&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="447" y="758" width="193" height="96" as="geometry"/></mxCell><mxCell id="ev" value="&lt;b&gt;Evaluation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Trained with class weights (no resampling) and scored once on the held-out test set: macro-F1, accuracy, ROC-AUC, per-class scores and confusion matrices. Compared with bootstrap and McNemar tests, an ablation, and ten re-splits with a Wilcoxon test. SHAP values and a close look at errors.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="894" width="620" height="118" as="geometry"/></mxCell><mxCell id="soa" value="&lt;b&gt;Emotion analysis&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Share of each main emotion on every platform, compared with a chi-square test and Cramér&amp;#x27;s V. On Bugzilla and GitHub, emotion scores compared across label classes with the Kruskal–Wallis test.&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Helvetica;fontSize=13;spacing=6;" vertex="1" parent="1"><mxGeometry x="680" y="758" width="200" height="254" as="geometry"/></mxCell><mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;exitX=0.5000;exitY=1;entryX=0.2419;entryY=0;" edge="1" parent="1" source="bz" target="cl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;exitX=0.5000;exitY=1;entryX=0.7581;entryY=0;" edge="1" parent="1" source="gh" target="cl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;exitX=0.5000;exitY=1;entryX=0.5000;entryY=0;" edge="1" parent="1" source="so" target="socl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;exitX=0.2419;exitY=1;entryX=0.5000;entryY=0;" edge="1" parent="1" source="cl" target="bzl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;exitX=0.7581;exitY=1;entryX=0.5000;entryY=0;" edge="1" parent="1" source="cl" target="ghl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;exitX=0.5000;exitY=1;entryX=0.5000;entryY=0;" edge="1" parent="1" source="socl" target="sol"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;exitX=0.5000;exitY=1;entryX=0.5000;entryY=0;" edge="1" parent="1" source="bzl" target="mk"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;exitX=0.5000;exitY=1;entryX=0.2419;entryY=0;" edge="1" parent="1" source="mk" target="fc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;exitX=0.5000;exitY=1;entryX=0.7581;entryY=0;" edge="1" parent="1" source="ghl" target="fc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;exitX=0.1559;exitY=1;entryX=0.5000;entryY=0;" edge="1" parent="1" source="fc" target="m1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;exitX=0.5000;exitY=1;entryX=0.1559;entryY=0;" edge="1" parent="1" source="m1" target="ev"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;exitX=0.5000;exitY=1;entryX=0.5000;entryY=0;" edge="1" parent="1" source="fc" target="m2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;exitX=0.5000;exitY=1;entryX=0.5000;entryY=0;" edge="1" parent="1" source="m2" target="ev"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;exitX=0.8441;exitY=1;entryX=0.5000;entryY=0;" edge="1" parent="1" source="fc" target="m3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;exitX=0.5000;exitY=1;entryX=0.8441;entryY=0;" edge="1" parent="1" source="m3" target="ev"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;exitX=0.5000;exitY=1;entryX=0.5000;entryY=0;" edge="1" parent="1" source="sol" target="soa"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="div" style="endArrow=none;dashed=1;html=1;strokeColor=#BBBBBB;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660" y="15" as="sourcePoint"/><mxPoint x="660" y="1012" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>